{
  "name": "lyria-song-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode selfhosted",
    "local": "node scripts/start-local.mjs",
    "local:doctor": "node scripts/local-doctor.mjs",
    "local:gpu-check": "node scripts/gpu-check.mjs",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && vite build --mode selfhosted",
    "local-server": "node local-server/index.js",
    "local-server:mock": "LOCAL_MOCK=1 node local-server/index.js",
    "local-server:install": "node scripts/install-cpu.mjs",
    "local-server:install-gpu": "node scripts/install-gpu.mjs",
    "local-server:real": "node scripts/run-python-server.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:local": "vite preview --mode selfhosted --outDir dist-local"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
